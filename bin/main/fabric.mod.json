{
  "schemaVersion": 1,
  "id": "indrev",
  "version": "${version}",
  "name": "Industrial Revolution",
  "description": "Every other industrial mod ever",
  "authors": [
    "Gabriel Henrique de Oliveira"
  ],
  "contributors": [
  ],
  "contact": {
    "homepage": "https://github.com/GabrielOlvH/Industrial-Revolution",
    "sources": "https://github.com/GabrielOlvH/Industrial-Revolution"
  },
  "license": "Apache-2.0",
  "icon": "assets/indrev/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "me.mervyn.indrev.IndustrialRevolution"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "me.mervyn.indrev.IndustrialRevolutionClient"
      }
    ],
    "rei_client": [
      {
        "adapter": "kotlin",
        "value": "me.mervyn.indrev.compat.rei.REIPlugin"
      }
    ],
    "fabric-datagen": [
      {
        "adapter": "kotlin",
        "value": "me.mervyn.indrev.datagen.IndustrialRevolutionDatagen"
      }
    ],
    "dashloader": [
      {
        "adapter": "kotlin",
        "value": "me.mervyn.indrev.compat.dashloader.IndRevDashLoaderPlugin"
      }
    ]
  },
  "custom": {
  },
  "mixins": [
    "indrev.mixins.json"
  ],
  "accessWidener": "indrev.accesswidener",
  "depends": {
    "fabricloader": ">=0.7.1",
    "fabric": ">=0.32.0",
    "fabric-language-kotlin": ">=1.6.0",
    "minecraft": ">=1.20",
    "libgui": "*"
  }
}
